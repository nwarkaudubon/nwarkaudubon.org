---
import type { FieldTrip } from '../lib/notion';

interface Props {
  trip: FieldTrip;
}

const { trip } = Astro.props;
const upcoming = !trip.isPast;

// Status pill: "Full" (set in Notion, or the reserved total reached the limit),
// plus Postponed and Canceled.
const statusPill = !upcoming
  ? null
  : trip.isFull
    ? 'Full'
    : ['Postponed', 'Canceled'].includes(trip.status)
      ? trip.status
      : null;

// RSVPs matter more when space is limited, so call out the limit on open trips.
const limitPill = upcoming && !trip.isFull && trip.status === 'Announced' && trip.limit != null ? trip.limit : null;
---

{trip.kind === 'event' && <span class="badge badge-event">Event</span>}
{trip.kind === 'series' && <span class="badge badge-event">Series</span>}
{statusPill &&<span class={`badge badge-${statusPill.toLowerCase()}`}>{statusPill}</span>}
{limitPill !== null && <span class="badge badge-limit">Limited to {limitPill}</span>}
