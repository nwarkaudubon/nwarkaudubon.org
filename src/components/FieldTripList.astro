---
import { formatNames, formatTripDate, type FieldTrip } from '../lib/notion';
import TripBadges from './TripBadges.astro';

interface Props {
  trips: FieldTrip[];
}

const { trips } = Astro.props;
---

{
  trips.map((trip) => {
    return (
      <article class="field-trip">
        <h3>
          <a href={`/field-trips/${trip.slug}/`}>{trip.name}</a>
          <TripBadges trip={trip} />
        </h3>
        <p class="trip-meta">
          {formatTripDate(trip)}
          {trip.location && <> · {trip.location}</>}
        </p>
        {!trip.isPast && trip.leaders.length > 0 && (
          <p class="trip-meta">Led by {formatNames(trip.leaders.map((l) => l.name))}</p>
        )}
        {trip.isPast && trip.checklistUrl && (
          <p class="trip-meta"><a href={trip.checklistUrl}>eBird checklist</a></p>
        )}
      </article>
    );
  })
}
