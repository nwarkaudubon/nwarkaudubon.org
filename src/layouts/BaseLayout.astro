---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BannerCollage from '../components/BannerCollage.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Ask search engines not to list this page (used for archived content). */
  noindex?: boolean;
  /** Featured image shown at the top of the page, e.g. "/images/places/x.jpg" (a file in public/). */
  image?: string;
  /** Alt text for the featured image (required when `image` is set; describe what's in the photo). */
  imageAlt?: string;
  /** Optional photo credit shown under the featured image. */
  imageCredit?: string;
  /** Pages without a featured image show the random banner. Set false to show neither. */
  banner?: boolean;
}

const siteName = 'Northwest Arkansas Audubon Society';
const {
  title,
  description = 'A Northwest Arkansas community non-profit committed to preserving the natural world through education, environmental study, and habitat protection.',
  noindex = false,
  image,
  imageAlt = '',
  imageCredit,
  banner = true,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/libre-baskerville-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {!image && banner && <BannerCollage />}
    <main id="main">
      <div class="wrapper">
        {
          image && (
            <figure class="featured-image">
              <img src={image} alt={imageAlt} />
              {imageCredit && <figcaption>{imageCredit}</figcaption>}
            </figure>
          )
        }
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
