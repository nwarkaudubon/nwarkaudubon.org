---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const topics = (await getCollection('conservation')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Conservation"
  description="Information on how to help birds and the places they live in Northwest Arkansas."
>
  <p><a href="/resources/">&larr; Resources</a></p>
  <h1>Conservation</h1>
  <p>
    Information on how we can all help birds and the habitat they depend on. Feel free to share
    these pages when you're talking about these issues with others.
  </p>

  <ul class="topic-list">
    {
      topics.map((topic) => (
        <li>
          {topic.data.externalUrl ? (
            <a href={topic.data.externalUrl}>{topic.data.title}</a>
          ) : (
            <a href={`/resources/conservation/${topic.id}/`}>{topic.data.title}</a>
          )}
          <br />
          <span class="trip-meta">{topic.data.description}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
