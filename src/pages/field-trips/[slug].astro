---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripBadges from '../../components/TripBadges.astro';
import StandardInfo from '../../components/StandardInfo.astro';
import {
  getFieldTrips,
  getLeaderBioHtml,
  getTripBodyHtml,
  formatNames,
  formatTripDate,
  spotsLeft,
  type FieldTrip,
  type Leader,
} from '../../lib/notion';

export async function getStaticPaths() {
  const trips = await getFieldTrips();
  const paths = [];
  // Sequential on purpose: Notion limits requests to about 3 per second.
  for (const trip of trips) {
    const bodyHtml = await getTripBodyHtml(trip.id, trip.kind === 'series');
    const leaderBios = [];
    for (const leader of trip.leaders) {
      leaderBios.push({ ...leader, html: await getLeaderBioHtml(leader.id) });
    }
    paths.push({ params: { slug: trip.slug }, props: { trip, bodyHtml, leaderBios } });
  }
  return paths;
}

interface Props {
  trip: FieldTrip;
  bodyHtml: string;
  leaderBios: (Leader & { html: string })[];
}

const { trip, bodyHtml, leaderBios } = Astro.props;
// Show a leader's section if they have a bio or contact info.
const bios = leaderBios.filter((b) => b.html || b.email || b.phone);
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
// RSVP call-outs are for field trips only.
const open = trip.kind === 'trip' && !trip.isPast && !trip.isFull && trip.status === 'Announced';
const full = trip.kind === 'trip' && !trip.isPast && trip.isFull;
// Weather and "about" text only matter for trips that are still happening.
// Events (fundraisers, conventions, etc.) don't get it.
const showStandardInfo = trip.kind !== 'event' && !trip.isPast && ['Announced', 'Full'].includes(trip.status);
// A series is drop-in: it says so instead of asking for RSVPs.
const dropIn = trip.kind === 'series' && !trip.isPast && trip.status === 'Announced';
const left = open ? spotsLeft(trip) : null;
const rsvpBody = encodeURIComponent('Name:\nNumber in party:\n');
const mailto = (prefix: string) =>
  `mailto:trips@nwarkaudubon.org?subject=${encodeURIComponent(`${prefix}: ${trip.name}`)}&body=${rsvpBody}`;
---

<BaseLayout title={trip.name}>
  <p><a href="/field-trips/">&larr; All field trips &amp; events</a></p>

  <h1>
    {trip.name}
    <TripBadges trip={trip} />
  </h1>

  <dl class="trip-details">
    <dt>When</dt>
    <dd>
      {formatTripDate(trip)}
      {trip.pattern && <><br />{trip.pattern}</>}
    </dd>
    {
      trip.leaders.length > 0 && (
        <>
          <dt>Led by</dt>
          <dd>{formatNames(trip.leaders.map((l) => l.name))}</dd>
        </>
      )
    }
    {
      trip.location && (
        <>
          <dt>Where</dt>
          <dd>{trip.location}</dd>
        </>
      )
    }
    {
      trip.coordinates && (
        <>
          <dt>GPS</dt>
          <dd>
            {trip.coordinates}
            {trip.mapUrl && <> (<a href={trip.mapUrl}>map</a>)</>}
          </dd>
        </>
      )
    }
    {
      trip.isPast && trip.checklistUrl && (
        <>
          <dt>Results</dt>
          <dd><a href={trip.checklistUrl}>eBird checklist</a></dd>
        </>
      )
    }
  </dl>

  {
    open && (
      <div class="callout">
        {trip.limit != null && (
          <p>
            <strong>This trip is limited to {trip.limit} participants.</strong>
            {left !== null && <> {left === 0 ? 'No spots are left.' : `${left} ${left === 1 ? 'spot is' : 'spots are'} left.`}</>}
            {' '}Please RSVP so we can plan for the group.
          </p>
        )}
        <p>
          <strong>To RSVP,</strong> email{' '}
          <a href={mailto('RSVP')}>trips@nwarkaudubon.org</a>{' '}
          with the trip name, your name, and the number in your party.
        </p>
      </div>
    )
  }
  {
    dropIn && (
      <div class="callout">
        <p>
          <strong>No RSVP needed.</strong> Just join us at the start time for any outing that
          works for you.
        </p>
      </div>
    )
  }
  {
    full && (
      <div class="callout">
        <p>
          <strong>This trip is full.</strong>
          {trip.waitlist ? ` ${trip.waitlist} ${trip.waitlist === 1 ? 'person is' : 'people are'} on the waitlist.` : ''}
          {' '}Please RSVP anyway to join the waitlist. People often cancel at the last minute, so spots do open up.
        </p>
        <p>
          <strong>To join the waitlist,</strong> email{' '}
          <a href={mailto('Waitlist')}>trips@nwarkaudubon.org</a>{' '}
          with the trip name, your name, and the number in your party.
        </p>
      </div>
    )
  }

  <div class="trip-body" set:html={bodyHtml} />

  {
    bios.length > 0 && (
      <section class="leader-bios">
        <h2>{bios.length === 1 ? 'About your trip leader' : 'About your trip leaders'}</h2>
        {bios.map((b) => (
          <>
            <h3>{b.name}</h3>
            {(b.email || b.phone) && (
              <p>
                {b.email && <><a href={`mailto:${b.email}`}>{b.email}</a></>}
                {b.email && b.phone && ' · '}
                {b.phone && <><a href={telHref(b.phone)}>{b.phone}</a></>}
              </p>
            )}
            <div class="trip-body" set:html={b.html} />
          </>
        ))}
      </section>
    )
  }

  {showStandardInfo && <StandardInfo series={trip.kind === 'series'} />}
</BaseLayout>
