---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldTripList from '../../components/FieldTripList.astro';
import { getUpcomingTrips, getPastTrips } from '../../lib/notion';

const upcoming = await getUpcomingTrips();
const past = await getPastTrips();
---

<BaseLayout title="Field Trips & Events">
  <h1>Field Trips &amp; Events</h1>
  <p>
    Our field trips are free and open to everyone, and beginning birders are always welcome.
    Join our field trip email list, or ask a question: <a href="mailto:trips@nwarkaudubon.org">trips@nwarkaudubon.org</a>.
  </p>

  <h2>Upcoming</h2>
  {
    upcoming.length > 0 ? (
      <FieldTripList trips={upcoming} />
    ) : (
      <p>No field trips or events are announced right now. Check back soon!</p>
    )
  }

  <h2>Past field trips &amp; events</h2>
  {past.length > 0 ? <FieldTripList trips={past} /> : <p>Nothing here yet.</p>}
</BaseLayout>
