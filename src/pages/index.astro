---
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldTripList from '../components/FieldTripList.astro';
import { getUpcomingTrips } from '../lib/notion';

const upcoming = await getUpcomingTrips();
---

<BaseLayout>
  <h1>Northwest Arkansas Audubon Society</h1>
  <p class="lead">
    The Northwest Arkansas Audubon Society is a registered non-profit organization serving
    Benton, Carroll, Madison and Washington counties, committed to preserving the natural
    world in Northwest Arkansas through education, environmental study and habitat protection.
  </p>

  <section class="callout">
    <h2>Quick links</h2>
    <ul>
      <li><a href="/places-to-bird/">Places to Bird in Northwest Arkansas</a></li>
      <li><a href="/conservation/window-collisions/">Preventing Window Collisions at Home</a></li>
      <li>
        Injured bird? Check the
        <a href="https://www.onthefeeder.com/wildlife-rescue-directory/">Wildlife Rescue Directory</a>
      </li>
      <li><a href="https://www.facebook.com/nwarkaudubon">NWAAS on Facebook</a></li>
    </ul>
  </section>

  <section>
    <h2>Upcoming Field Trips &amp; Events</h2>
    <p>
      Our field trips are free and open to everyone, and beginning birders are always welcome.
      Join our field trip email list, or ask a question: <a href="mailto:trips@nwarkaudubon.org">trips@nwarkaudubon.org</a>.
    </p>
    {
      upcoming.length > 0 ? (
        <FieldTripList trips={upcoming} />
      ) : (
        <p>No field trips are announced right now. Check back soon, or follow us on Facebook.</p>
      )
    }
    <p><a href="/field-trips/">See all field trips and events, including past ones &rarr;</a></p>
  </section>
</BaseLayout>
